# =========================================================================
# Hospital Lab Management System — Example Configuration Template
# COPY THIS FILE TO application.properties (DO NOT COMMIT REAL PASSWORDS/TOKENS)
# =========================================================================

# Database Connection
spring.datasource.url=jdbc:mysql://localhost:3307/lab_management_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_DATABASE_PASSWORD_HERE

# Hibernate settings
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.show-sql=true

# Jackson JSON serialization settings
spring.jackson.serialization.fail-on-empty-beans=false

# Server Port
server.port=8080

# Report storage directory
lms.reports.storage-dir=storage/reports

# ============================================================
# SMS Gateway Configuration (text.lk API v3)
# ============================================================
# Enable SMS when you have active text.lk credentials
lms.sms.enabled=false

# API endpoint
lms.sms.api-url=https://app.text.lk/api/v3/sms/send

# Your API Bearer Token from text.lk dashboard
lms.sms.api-token=YOUR_TEXT_LK_API_TOKEN_HERE

# Your approved Sender ID (up to 11 alphanumeric characters)
lms.sms.sender-id=CityDiagLab

# Frontend URL for patient report links
lms.sms.report-base-url=http://localhost:3000
